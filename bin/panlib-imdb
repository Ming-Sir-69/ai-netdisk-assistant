#!/usr/bin/env python3
"""panlib-imdb - IMDB ID 解析器（默认联网查询）

查询默认联网（Wikidata 结构化数据），这是唯一的真实查询路径：
- 优先用 --imdb-id 参数（AI 已知的 ID）
- --title 必须配 --year，直接联网消歧
- 内置已知表只是测试夹具，仅 --known-table 显式启用，离线也不用

已知表不再扩展：真实查询一律走网络。
"""

import argparse
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "panlib"))

from common import INVALID_ARG, NETWORK, NOT_FOUND, emit_error, emit_success
from titledb import LookupError as TitleLookupError, lookup as titledb_lookup


# 内置已知 IMDb 表（初始公开样例）
IMDB_KNOWN: dict[str, dict] = {
    # 中文名 → 详情
    "永无止境": {
        "imdb_id": "tt1219289",
        "title_en": "Limitless",
        "year": "2011",
        "douban_id": "2129138",
    },
    "史密斯夫妇": {
        "imdb_id": "tt0356910",
        "title_en": "Mr. & Mrs. Smith",
        "year": "2005",
        "douban_id": "1309199",
    },
    "土拨鼠之日": {
        "imdb_id": "tt0107048",
        "title_en": "Groundhog Day",
        "year": "1993",
        "douban_id": "1293010",
    },
    "玩具总动员5": {
        "imdb_id": "tt29355505",
        "title_en": "Toy Story 5",
        "year": "2026",
        "douban_id": "36599707",
    },
    "玩具总动员": {
        "imdb_id": "tt0114709",
        "title_en": "Toy Story",
        "year": "1995",
        "douban_id": "1291572",
    },
    # 英文名 → 详情（同一资源）
    "Limitless": {
        "imdb_id": "tt1219289",
        "title_en": "Limitless",
        "year": "2011",
        "douban_id": "2129138",
    },
    "Mr. & Mrs. Smith": {
        "imdb_id": "tt0356910",
        "title_en": "Mr. & Mrs. Smith",
        "year": "2005",
        "douban_id": "1309199",
    },
    "Groundhog Day": {
        "imdb_id": "tt0107048",
        "title_en": "Groundhog Day",
        "year": "1993",
        "douban_id": "1293010",
    },
    "Toy Story 5": {
        "imdb_id": "tt29355505",
        "title_en": "Toy Story 5",
        "year": "2026",
        "douban_id": "36599707",
    },
}


def validate_imdb_id(imdb_id: str) -> bool:
    """验证 IMDB ID 格式: tt + 7-8 位数字."""
    return bool(re.match(r'^tt\d{7,8}$', imdb_id.strip()))


def lookup_known(title: str) -> dict | None:
    """查内置已知表."""
    title_clean = title.strip()
    if title_clean in IMDB_KNOWN:
        return IMDB_KNOWN[title_clean]
    # 模糊匹配：忽略大小写
    title_lower = title_clean.lower()
    for key, value in IMDB_KNOWN.items():
        if key.lower() == title_lower:
            return value
    return None


def main() -> None:
    parser = argparse.ArgumentParser(
        description="IMDB ID 解析器（已知表 + 验证）",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
示例:
  panlib-imdb --imdb-id tt1219289
  panlib-imdb --title "永无止境" --year 2011
  panlib-imdb --title "永无止境" --year 2011 --known-table   # 仅测试用
        """,
    )
    parser.add_argument("--imdb-id", help="已知 IMDB ID (ttXXX) — 优先使用")
    parser.add_argument("--title", "-t", help="影视名称，默认联网查询（需配 --year）")
    parser.add_argument("--year", type=int, help="发行年份，联网查询时用于消歧（必填）")
    parser.add_argument(
        "--online",
        action="store_true",
        help="已废弃：联网查询现在是默认行为，保留仅为兼容旧调用",
    )
    parser.add_argument(
        "--known-table",
        action="store_true",
        help="仅测试用：查内置已知表（测试夹具），真实查询与离线场景都禁用",
    )
    parser.add_argument("--quiet", "-q", action="store_true", help="静默模式")
    args = parser.parse_args()

    # 路径 1: 直接验证已知 ID
    if args.imdb_id:
        imdb_id = args.imdb_id.strip()
        if not validate_imdb_id(imdb_id):
            emit_error(INVALID_ARG, f"IMDB ID 格式错误: {imdb_id}",
                       {"expected": "tt + 7-8 位数字", "got": imdb_id})
        emit_success({"imdb_id": imdb_id},
                     meta={"source": "user-provided", "validated": True})
        return

    # 路径 2: --title 查询（默认联网；已知表仅 --known-table 测试用）
    if args.title:
        if args.known_table:
            result = lookup_known(args.title)
            if result:
                emit_success(result, meta={"source": "known-table", "query": args.title})
                return
            emit_error(
                NOT_FOUND,
                f"内置已知表（测试夹具）无 '{args.title}'",
                details={"hint": "真实查询请去掉 --known-table，用 --title + --year 联网查询；或用 --imdb-id 显式提供"},
            )
            return
        if args.year is None:
            emit_error(INVALID_ARG, "联网查询需要 --year 用于消歧（中文译名撞名很常见）")
            return
        try:
            found = titledb_lookup(args.title, args.year)
        except TitleLookupError as exc:
            # 查不通 ≠ 查过且没有。前者绝不能被当成写 {imdb-none} 的依据。
            emit_error(NETWORK, str(exc))
            return
        if found["status"] == "found":
            candidate = found["candidates"][0]
            emit_success(
                candidate,
                meta={"source": found.get("source", "wikidata"), "query": args.title, "year": args.year},
            )
            return
        if found["status"] == "ambiguous":
            # 不替调用方挑：撞名猜错会把错误编号永久写进文件名。
            emit_error(
                INVALID_ARG,
                f"'{args.title}' ({args.year}) 命中多个候选，需人工或 AI 裁决",
                details={"candidates": found["candidates"]},
            )
            return
        emit_error(
            NOT_FOUND,
            f"Wikidata 中查无 '{args.title}' ({args.year})",
            details={"searched": "wikidata", "meaning": "查过且没有，可据此写 {imdb-none}"},
        )
        return

    # 都没给
    emit_error(INVALID_ARG, "必须提供 --imdb-id 或 --title")


if __name__ == "__main__":
    main()
