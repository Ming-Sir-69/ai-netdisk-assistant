#!/usr/bin/env python3
"""Default macOS bridge from panlib JSON requests to official Baidu MCP SSE."""

from __future__ import annotations

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "panlib"))

from baidu_mcp import BaiduMCPClient, BaiduMCPError  # noqa: E402
from common import redact_text  # noqa: E402
from secure_provider import (  # noqa: E402
    CredentialError,
    CredentialExpired,
    CredentialUnavailable,
    secure_provider_from_environment,
)


def _error(code: str, message: str, details=None) -> int:
    payload = {"error": {"code": code, "message": redact_text(message)}}
    if details is not None:
        payload["error"]["details"] = details
    print(json.dumps(payload, ensure_ascii=False))
    return 1


USAGE = """panlib-mcp-bridge —— panlib JSON 请求 → 官方百度 MCP SSE 的桥接层。

这是**内部子进程**，不是给 Agent 或人使用的命令行入口：它从 stdin 读一个
JSON 请求 {"tool": "...", "arguments": {...}}，把结果写到 stdout。
请通过 bin/panlib-library 调用，不要直接运行本文件。

之所以仍然实现 --help：一个"没有 --help"的可执行文件无法自证它是故意如此，
还是坏了。CI 的 help 巡检会把两者一律判为失败，此前只能靠人记住"这个不用查"——
而这正是本仓库反复吃亏的那类隐性知识。现在它自己说得清楚。
"""


def main() -> int:
    if any(a in ("-h", "--help") for a in sys.argv[1:]):
        print(USAGE)
        return 0
    try:
        request = json.loads(sys.stdin.read())
        if not isinstance(request, dict) or not isinstance(request.get("tool"), str):
            return _error("INVALID_ARG", "bridge request must contain a tool")
        tool = request["tool"]
        arguments = request.get("arguments") or {}
        if not isinstance(arguments, dict):
            return _error("INVALID_ARG", "bridge arguments must be an object")
        provider = secure_provider_from_environment()
        if tool == "auth_status":
            status = provider.status()
            print(
                json.dumps(
                    {
                        "backend": status.backend,
                        "available": status.available,
                        "configured": status.configured,
                        "reason": status.reason,
                        "expires_at": status.expires_at,
                        "scope": status.scope,
                    },
                    ensure_ascii=False,
                )
            )
            return 0 if status.configured else 1
        token = provider.token()
        result = BaiduMCPClient.from_environment(token).call_tool(tool, arguments)
        print(json.dumps(result, ensure_ascii=False, default=str))
        return 0
    except CredentialExpired as exc:
        return _error("AUTH", "MCP credential has expired", {"expires_at": exc.expires_at})
    except CredentialUnavailable as exc:
        return _error("AUTH", str(exc))
    except CredentialError as exc:
        return _error("AUTH", str(exc))
    except BaiduMCPError as exc:
        return _error(exc.code, str(exc), exc.details)
    except (ValueError, json.JSONDecodeError) as exc:
        return _error("INVALID_ARG", str(exc))
    except Exception as exc:  # pragma: no cover - final process boundary
        return _error("NETWORK", "MCP bridge failed", {"type": type(exc).__name__})


if __name__ == "__main__":
    raise SystemExit(main())
