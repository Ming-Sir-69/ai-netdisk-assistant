                "expect": "看到目标集的 mkv 列表，记下所有 fs_id 和文件名里的清晰度",
                "on_fail": "同上，用 panlib-run retry",
            },
            {
                "why": "精准转存到隔离区（不直接落类别根，便于分辨本次转了什么）",
                "cmd": f'{PY} bin/panlib-run transfer-select -r <resource_id> '
                       f'--fsid <id1>,<id2>,... --dest-dir "/apps/bdpan/片库/TV shows/_待整理_{{title_slug}}"',
                "expect": "executed=true，隔离区文件数 == fs_id 数",
