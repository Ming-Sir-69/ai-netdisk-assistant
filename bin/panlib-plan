#!/usr/bin/env python3
"""任务路由器：把意图翻译成确定性的算子序列，消除"不知道该用什么工具"。

设计目标是降低模型的决策负担，而不是增加文档量：
- 模型只需说出意图（"我要某剧某季 4K"），路由器给出逐条命令；
- 每一步都自带验收判据和失败对策，模型照做即可，不必自行推理；
- 关键的顺序性知识（先查已有、先 browse 再 select）被编码进配方，
  而不是指望模型读过 SKILL.md 的某一段。

用法：
  panlib-plan list
  panlib-plan show --task acquire-season
  panlib-plan show --task acquire-season --title "Stranger Things" --season 5
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "panlib"))
from common import emit_success, emit_error, INVALID_ARG  # noqa: E402

PY = ".venv/bin/python"

