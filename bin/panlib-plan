def render(task: str, params: dict) -> dict:
    recipe = RECIPES[task]
    steps = []
    for i, s in enumerate(recipe["steps"], 1):
        cmd = s["cmd"]
        for k, v in params.items():
            cmd = cmd.replace("{" + k + "}", str(v))
        steps.append({"step": i, "why": s["why"], "cmd": cmd,
                      "expect": s["expect"], "on_fail": s["on_fail"]})
    return {"task": task, "summary": recipe["summary"],
            "critical": recipe["critical"], "steps": steps,
            "rule": "按顺序执行；每步先看 expect 是否满足，不满足按 on_fail 处理，不要跳步。"}


def main() -> int:
    p = argparse.ArgumentParser(description="任务路由器：意图 → 确定性算子序列")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list", help="列出所有可用配方")
    s = sub.add_parser("show", help="展开某个配方")
    s.add_argument("--task", required=True)
    s.add_argument("--title", default="<片名>")
    s.add_argument("--season", default="<N>")

    a = p.parse_args()
    if a.cmd == "list":
        emit_success(
            {"recipes": [{"task": k, "summary": v["summary"], "steps": len(v["steps"])}
                         for k, v in RECIPES.items()],
             "usage": "panlib-plan show --task <task> 展开逐条命令"},
            {"command": "panlib-plan list", "mode": "read-only"})
        return 0
    if a.task not in RECIPES:
        emit_error(INVALID_ARG, f"unknown task: {a.task}",
                   {"available": sorted(RECIPES)})
        return 1
    slug = str(a.title).replace(" ", "_")
    emit_success(render(a.task, {"title": a.title, "season": a.season, "title_slug": slug}),
                 {"command": "panlib-plan show", "mode": "read-only"})
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
