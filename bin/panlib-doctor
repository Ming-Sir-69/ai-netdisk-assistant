#!/usr/bin/env bash
# Read-only local/environment diagnostic. Account bodies are never emitted.

set -u

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
DEFAULT_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)"
ROOT="${PANLIB_ROOT:-$DEFAULT_ROOT}"
PYTHON_VALUE="${PANLIB_PYTHON_BIN:-$ROOT/.venv/bin/python}"
BDPAN_VALUE="${BDPAN_BIN:-bdpan}"

usage() {
    cat <<'EOF'
Usage: panlib-doctor

Runs bounded, read-only checks for the project Python environment, dependencies,
bdpan version/authentication, and the Baidu network endpoint.
  -h, --help  Show this help without running any check.
EOF
}

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    "") ;;
    *) printf 'panlib-doctor: unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
esac

python_status="missing"
python_version=""
dependency_status="unknown"
bdpan_status="missing"
bdpan_version=""
auth_status="unknown"
network_status="skipped"
overall="not_ready"
guidance=""

add_guidance() {
    guidance="${guidance:+$guidance }$1"
}

modules_from_requirements() {
    local modules=""
    local distribution module
    for distribution in $(sed -nE 's/^[[:space:]]*([A-Za-z0-9_.-]+).*/\1/p' "$ROOT/requirements.txt" 2>/dev/null); do
        distribution="$(printf '%s' "$distribution" | tr '[:upper:]' '[:lower:]')"
        case "$distribution" in
            beautifulsoup4) module="bs4" ;;
            *) module="$(printf '%s' "$distribution" | tr '-' '_')" ;;
        esac
        modules="${modules:+$modules,}$module"
    done
    printf '%s' "$modules"
}

TIMEOUT_PYTHON="${PANLIB_TIMEOUT_PYTHON:-python3}"
COMMAND_TIMEOUT="${PANLIB_COMMAND_TIMEOUT:-5}"
case "$COMMAND_TIMEOUT" in ""|*[!0-9]*) COMMAND_TIMEOUT=5 ;; esac

run_timed() {
    "$TIMEOUT_PYTHON" -c 'import subprocess,sys
try:
    result = subprocess.run(sys.argv[2:], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            timeout=int(sys.argv[1]))
except subprocess.TimeoutExpired:
    sys.exit(124)
sys.stdout.buffer.write(result.stdout)
sys.stderr.buffer.write(result.stderr)
sys.exit(result.returncode)' "$COMMAND_TIMEOUT" "$@"
}

if [ -e "$PYTHON_VALUE" ] && [ ! -x "$PYTHON_VALUE" ]; then
    python_status="invalid"
elif command -v "$PYTHON_VALUE" >/dev/null 2>&1 || [ -x "$PYTHON_VALUE" ]; then
    if ! command -v "$TIMEOUT_PYTHON" >/dev/null 2>&1 && [ ! -x "$TIMEOUT_PYTHON" ]; then
        python_status="unchecked"
    else
        py_version_raw="$(run_timed "$PYTHON_VALUE" --version 2>&1)"
        python_exit=$?
        if [ "$python_exit" -eq 124 ]; then
            python_status="timeout"
        elif [ "$python_exit" -ne 0 ]; then
            python_status="error"
        else
            python_version="$(printf '%s' "$py_version_raw" | sed -nE 's/.*Python[[:space:]]+([0-9]+\.[0-9]+\.[0-9]+).*/\1/p')"
        fi
    fi
    if [ "$python_status" = "missing" ] && [ -z "$python_version" ]; then
        python_status="error"
    elif [ "$python_status" = "missing" ] && [ "$(printf '%s\n' "$python_version" | awk -F. '{ if ($1 > 3 || ($1 == 3 && $2 >= 13)) print "ok"; else print "old" }')" = "ok" ]; then
        python_status="ready"
    elif [ "$python_status" = "missing" ]; then
        python_status="unsupported"
    fi
fi

if [ "$python_status" = "ready" ]; then
    required_modules="${PANLIB_REQUIRED_MODULES:-}"
    if [ -z "$required_modules" ] && [ -f "$ROOT/requirements.txt" ]; then
        required_modules="$(modules_from_requirements)"
    fi
    if [ -z "$required_modules" ]; then
        dependency_status="ready"
    else
        run_timed "$PYTHON_VALUE" -c 'import importlib.util,sys
mods = [item.strip() for item in sys.argv[1].split(",") if item.strip()]
missing = [item for item in mods if importlib.util.find_spec(item) is None]
sys.exit(1 if missing else 0)' "$required_modules" >/dev/null 2>&1
        dependency_exit=$?
        if [ "$dependency_exit" -eq 0 ]; then
            dependency_status="ready"
        elif [ "$dependency_exit" -eq 124 ]; then
            dependency_status="timeout"
        else
            dependency_status="missing"
        fi
    fi
else
    dependency_status="blocked"
fi

if command -v "$BDPAN_VALUE" >/dev/null 2>&1 || [ -x "$BDPAN_VALUE" ]; then
    if ! command -v "$TIMEOUT_PYTHON" >/dev/null 2>&1 && [ ! -x "$TIMEOUT_PYTHON" ]; then
        bdpan_status="unchecked"
    else
        version_output="$(run_timed "$BDPAN_VALUE" --version 2>/dev/null)"
        version_exit=$?
        if [ "$version_exit" -eq 124 ]; then
            bdpan_status="timeout"
        else
            if [ -z "$version_output" ]; then
                version_output="$(run_timed "$BDPAN_VALUE" version 2>/dev/null)"
                version_exit=$?
            fi
            if [ "$version_exit" -eq 124 ]; then
                bdpan_status="timeout"
            elif [ "$version_exit" -ne 0 ]; then
                bdpan_status="error"
            else
                bdpan_version="$(printf '%s' "$version_output" | sed -nE 's/.*([0-9]+\.[0-9]+\.[0-9]+).*/\1/p' | head -n 1)"
                if [ -z "$bdpan_version" ]; then
                    bdpan_status="unknown"
                elif [ "$(printf '%s\n' "$bdpan_version" | awk -F. '{ if ($1 > 3 || ($1 == 3 && $2 > 8) || ($1 == 3 && $2 == 8 && $3 >= 0)) print "ok"; else print "old" }')" = "ok" ]; then
                    if run_timed "$BDPAN_VALUE" --help >/dev/null 2>&1; then
                        bdpan_status="ready"
                    elif [ "$?" -eq 124 ]; then
                        bdpan_status="timeout"
                    else
                        bdpan_status="error"
                    fi
                else
                    bdpan_status="unsupported"
                fi
            fi
        fi

        if [ "$bdpan_status" = "ready" ]; then
            if run_timed "$BDPAN_VALUE" whoami >/dev/null 2>&1; then
                auth_status="ready"
            else
                auth_exit=$?
                if [ "$auth_exit" -eq 124 ]; then
                    auth_status="timeout"
                else
                    auth_status="unauthenticated"
                fi
            fi
        fi
    fi
fi

if [ "${PANLIB_NETWORK_SKIP:-0}" = "1" ]; then
    network_status="skipped"
else
    curl_value="${PANLIB_CURL_BIN:-curl}"
    network_url="${PANLIB_NETWORK_URL:-https://pan.baidu.com}"
    if command -v "$curl_value" >/dev/null 2>&1 || [ -x "$curl_value" ]; then
        if "$curl_value" -fsSI --max-time "${PANLIB_NETWORK_TIMEOUT:-5}" "$network_url" >/dev/null 2>&1; then
            network_status="ready"
        else
            network_status="failure"
        fi
    else
        network_status="failure"
    fi
fi

case "$python_status" in
    missing) add_guidance "项目 .venv Python 缺失；请先运行 scripts/bootstrap.sh。" ;;
    invalid) add_guidance "项目 .venv Python 不可执行；不会自动替换。" ;;
    unsupported) add_guidance "Python 版本不受支持；需要 3.13+。" ;;
    timeout) add_guidance "Python 版本检查超时，已停止等待。" ;;
    unchecked) add_guidance "缺少独立的 Python 超时控制器，未执行环境检查。" ;;
    error) add_guidance "无法识别 Python 版本。" ;;
esac
if [ "$dependency_status" = "missing" ]; then add_guidance "依赖缺失；确认后运行 scripts/bootstrap.sh --install-deps。"; fi
if [ "$dependency_status" = "timeout" ]; then add_guidance "Python 依赖检查超时，已停止等待。"; fi
case "$bdpan_status" in
    missing) add_guidance "请人工安装官方 bdpan。" ;;
    unsupported) add_guidance "当前 bdpan 版本不受支持，请人工确认升级。" ;;
    timeout) add_guidance "bdpan 只读检查超时，已停止等待。" ;;
    unknown|error|unchecked) add_guidance "无法安全确认 bdpan 状态，请检查安装。" ;;
esac
if [ "$auth_status" = "unauthenticated" ]; then add_guidance "请通过 scripts/login.sh 完成 OAuth。"; fi
if [ "$auth_status" = "timeout" ]; then add_guidance "bdpan 认证检查超时。"; fi
if [ "$network_status" = "failure" ]; then add_guidance "百度网盘网络入口不可达，请检查网络。"; fi

if [ "$python_status" = "ready" ] && [ "$dependency_status" = "ready" ] && [ "$bdpan_status" = "ready" ] \
    && [ "$auth_status" = "ready" ] && [ "$network_status" != "failure" ]; then
    overall="ready"
fi

version_json="null"
if [ -n "$python_version" ]; then version_json="\"$python_version\""; fi
bdpan_version_json="null"
if [ -n "$bdpan_version" ]; then bdpan_version_json="\"$bdpan_version\""; fi

printf '{"status":"%s","checks":{"python":{"status":"%s","version":%s},"dependencies":{"status":"%s"},"bdpan":{"status":"%s","version":%s},"auth":{"status":"%s"},"network":{"status":"%s"}},"next_steps":[' \
    "$overall" "$python_status" "$version_json" "$dependency_status" "$bdpan_status" "$bdpan_version_json" "$auth_status" "$network_status"
if [ -n "$guidance" ]; then printf '"%s"' "$guidance"; fi
printf ']}\n'

if [ "$overall" = "ready" ]; then
    printf '%s\n' 'panlib-doctor: ready (read-only checks only).' >&2
    exit 0
fi
printf 'panlib-doctor: %s\n' "${guidance:-本地环境尚未就绪。}" >&2
exit 1
