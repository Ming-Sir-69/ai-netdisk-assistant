# seedhub-baidu-pan-workflow — environment template
# Copy this file to `.env` and fill in your values. .env is gitignored.

# 百度网盘 CLI 命令（留给 PATH 解析；需要时可填绝对路径）
BDPAN_BIN=bdpan

# 百度网盘资源根目录（OAuth scope 硬限制 /apps/bdpan/，一般无需修改）
BDPAN_BASE=/apps/bdpan

# 资源根分类（一般无需修改）
BDPAN_LIB=片库

# seedhub-cli vendor 路径（一般无需修改，CLI 内部自动定位）
SEEDHUB_CLI=vendor/seedhub-cli/seedhub.py

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# 是否启用 IMDB 已知表查询（默认 true；false 则全部要求用户提供 IMDB ID）
USE_KNOWN_IMDB_TABLE=true

# 网络超时（秒）
NETWORK_TIMEOUT=30
BDPAN_TIMEOUT=600
